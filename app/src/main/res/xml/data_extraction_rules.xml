<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not migrate the local Device Owner status-bar ownership marker. -->
        <exclude domain="sharedpref" path="device_owner_status_bar_policy.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_owner_status_bar_policy.xml" />
    </device-transfer>
</data-extraction-rules>
