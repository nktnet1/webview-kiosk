<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews are inflated by SystemUI; AppCompat app:tint cannot be used here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="UseAppTint"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_media_artwork"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notification_media_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_media_title"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/notification_media_artist"
                style="@style/TextAppearance.Compat.Notification.Line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notification_media_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/notification_background_media_progress"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_media_previous"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_background_media_previous"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/notification_media_play_pause"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_background_media_pause"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_pause"
            android:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/notification_media_next"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_background_media_next"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/notification_media_stop"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_background_media_stop"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_media_rewind"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_background_media_rewind"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_rew"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/notification_media_forward"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_background_media_forward"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_ff"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notification_media_speed"
            style="@style/TextAppearance.Compat.Notification.Line2"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_background_media_speed_title"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
