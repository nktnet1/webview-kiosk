    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "^1.67.0",
    "next-themes": "^0.4.6",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "2.2.0",
    "seroval": "1.7.7",
