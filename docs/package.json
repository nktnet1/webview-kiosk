{
  "name": "docs-tanstack",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "serve dist/client",
    "preview": "vite preview",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "typecheck": "fumadocs-mdx && node scripts/generate-routes.mjs && tsc --noEmit",
